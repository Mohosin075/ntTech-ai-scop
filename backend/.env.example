NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:3000

# PostgreSQL connection string via Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/assessment_db?schema=public"

# Authentication
JWT_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="7d"
CORS_ORIGINS="http://localhost:3000"

# Optional: AI API Keys (If left empty, system automatically uses Rule-Based AI Fallback)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Fixed-fee baseline in USD per weighted scope point (not an hourly rate)
SOUTH_ASIA_SCOPE_POINT_USD=350
